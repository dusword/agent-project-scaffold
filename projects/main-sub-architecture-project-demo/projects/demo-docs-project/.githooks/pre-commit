#!/usr/bin/env bash
# ============================================================================
# 提交硬闸 · pre-commit
# ----------------------------------------------------------------------------
# 本仓库的两条纪律由这个钩子机器强制，不靠文字呼吁：
#
#   规则一（变更必留日志）：只要有任何非 CHANGE-LOG.md 的文件进入暂存区，
#                          CHANGE-LOG.md 就必须一起进入暂存区，否则拒绝提交。
#     └ 规则一之二（日志必须真的多一条）：CHANGE-LOG.md 光在暂存区里不算数，
#                          它的暂存 diff 里「记录行」必须**净增加**至少一行，
#                          否则拒绝。改写旧记录那一行 = 净增 0 = 不算。
#   规则二（结构变化必更 README）：暂存区里若有 docs/ 或 projects/ 下的
#                          新增 / 删除 / 改名，README.md 必须一起暂存，否则拒绝。
#                          （只管结构变化，不管内容改动 —— 避免噪音）
#
# 启用方式（每个仓库各做一次）：
#   git config core.hooksPath .githooks
#
# 诚实说明：
#   · git 层面的 `--no-verify` 仍可绕过本钩子，这是 git 自身的设计，无法在钩子内堵死。
#     本钩子的定位是「挡住忘记，而不是挡住蓄意」。
#   · 规则一之二只**数**记录行有没有多一条，**不判断**你写的内容对不对、写得好不好。
#     内容质量靠人工审阅，这里只保住「一条记录 = 一次提交」这个可数的不变量。
# ============================================================================

set -u

repo_root="$(git rev-parse --show-toplevel)" || exit 1
cd "$repo_root" || exit 1

# ---- 取暂存区变更（兼容首次提交：HEAD 尚不存在时与空树比较）----------------
# 🔴 core.quotepath=false 不能省：git 默认把非 ASCII 路径转义成 "docs/\346\236\266..."，
#    那样中文文件名既没法给人看，下面 ^docs/ 的前缀匹配也会因为多出来的引号而失效。
if git rev-parse --verify -q HEAD >/dev/null 2>&1; then
  diff_base="HEAD"
else
  diff_base="$(git hash-object -t tree /dev/null)"
fi
changes="$(git -c core.quotepath=false diff --cached --name-status -M "$diff_base")"

# 暂存区为空 → 无需检查（交给 git 自己报「nothing to commit」）
if [ -z "$changes" ]; then
  exit 0
fi

# ---- 展开成「状态 + 路径」两列；改名一行拆成新旧两条 ------------------------
# 输出格式：<状态字母>\t<路径>
flat="$(printf '%s\n' "$changes" | awk -F'\t' '
  function unq(p) {                      # 兜底：仍被 git 加了引号的路径去掉首尾引号
    if (substr(p,1,1) == "\"" && substr(p,length(p),1) == "\"")
      p = substr(p, 2, length(p) - 2)
    return p
  }
  {
    st = substr($1, 1, 1)
    if (st == "R" || st == "C") {
      print st "\t" unq($2)   # 旧路径（相当于删除）
      print st "\t" unq($3)   # 新路径（相当于新增）
    } else {
      print st "\t" unq($2)
    }
  }
')"

staged_paths="$(printf '%s\n' "$flat" | cut -f2 | sort -u)"

changelog_staged=0
readme_staged=0
other_staged=0

while IFS= read -r p; do
  [ -z "$p" ] && continue
  case "$p" in
    CHANGE-LOG.md) changelog_staged=1 ;;
    # 🔴 README.md 同时置 other_staged：它也是「非 CHANGE-LOG.md 的文件」，
    #    只改 README 也必须留日志。漏了这一句，规则一对纯 README 改动整个失效。
    README.md)     readme_staged=1; other_staged=1 ;;
    *)             other_staged=1 ;;
  esac
done <<EOF
$staged_paths
EOF

fail=0

# ---- 规则一：变更必留日志 --------------------------------------------------
if [ "$other_staged" -eq 1 ] && [ "$changelog_staged" -eq 0 ]; then
  fail=1
  echo "" >&2
  echo "❌ 提交被拒绝：本次改动没有记进 CHANGE-LOG.md" >&2
  echo "" >&2
  echo "   本仓库的铁律是「任何改动都要留下一行日志」。" >&2
  echo "   当前暂存的文件里没有 CHANGE-LOG.md：" >&2
  printf '%s\n' "$staged_paths" | sed 's/^/     · /' >&2
  echo "" >&2
  echo "   补救（三步）：" >&2
  echo "     1) 打开 CHANGE-LOG.md，在表格最上方插入一行：" >&2
  echo "        | $(date +%Y-%m-%d) | <改了什么> | <为什么> |" >&2
  echo "     2) git add CHANGE-LOG.md" >&2
  echo "     3) git commit  （重新执行你刚才那条提交命令）" >&2
  echo "" >&2
  echo "   注意：本闸门没有跳过开关。请补日志，不要找绕路。" >&2
  echo "" >&2
fi

# ---- 规则一之二：CHANGE-LOG.md 必须真的**新增**了一条记录 -------------------
# 为什么要有这一条：只查「在不在暂存区」挡不住「写坏了日志」。
# 实测事故：会话用 Edit 改日志时，把这次的说明揉进了**上一条记录那一行**——
# 文件确实变了、也确实暂存了，闸门照常放行，最终 5 次提交对 4 行记录，
# 「一条记录 = 一次提交」当场破功，全程零告警。
#
# 判据：记录行 = 首格是日期（YYYY-M-D）的表格行。这样表头行 `| 日期 | … |`
# 与 `|---|---|` 分隔行天然被排除，不必额外特判。
# 用「净增加」（新增行数 > 删除行数）而不是「有没有新增行」，是因为改写旧行
# 在 diff 里同样表现为一加一减——只有净增才说明真的多了一条记录。
if [ "$changelog_staged" -eq 1 ]; then
  cl_diff="$(git diff --cached -U0 "$diff_base" -- CHANGE-LOG.md)"
  cl_added="$(printf '%s\n' "$cl_diff" | grep -cE '^[+][|][^|]*[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}')"
  cl_removed="$(printf '%s\n' "$cl_diff" | grep -cE '^[-][|][^|]*[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}')"

  if [ "$cl_added" -le "$cl_removed" ]; then
    fail=1
    echo "" >&2
    echo "❌ 提交被拒绝：CHANGE-LOG.md 改了，但没有**新增**一条记录" >&2
    echo "" >&2
    echo "   本仓库的铁律是「一条记录 = 一次 git 提交」。" >&2
    echo "   本次 CHANGE-LOG.md 的暂存 diff：新增记录行 ${cl_added} 条 / 删除记录行 ${cl_removed} 条" >&2
    echo "   → 净增 0 条，等于这次提交在日志里找不到对应的那一行。" >&2
    echo "" >&2
    echo "   最常见的原因：**把这次的说明改写进了上一条记录那一行**，而不是另起一行。" >&2
    echo "   🔴 改旧行不算新增。旧记录是已经发生过的历史，不该被这次改动覆盖。" >&2
    echo "" >&2
    echo "   记录行长这样（新的加在表格最上方，一次提交一行）：" >&2
    echo "     | $(date +%Y-%m-%d) | <改了什么> | <为什么> |" >&2
    echo "" >&2
    echo "   补救（三步）：" >&2
    echo "     1) 打开 CHANGE-LOG.md，在表头下面**另起一行**写本次记录，别动上一条" >&2
    echo "     2) git add CHANGE-LOG.md" >&2
    echo "     3) git commit  （重新执行你刚才那条提交命令）" >&2
    echo "" >&2
    echo "   注意：本闸门没有跳过开关。它只数记录行有没有多一条，不看你写得好不好。" >&2
    echo "" >&2
  fi
fi

# ---- 规则二：结构变化必更 README -------------------------------------------
structural="$(printf '%s\n' "$flat" | awk -F'\t' '
  $1 ~ /^[ADRC]$/ && ($2 ~ /^docs\// || $2 ~ /^projects\//) { print $1 "\t" $2 }
')"

if [ -n "$structural" ] && [ "$readme_staged" -eq 0 ]; then
  fail=1
  echo "" >&2
  echo "❌ 提交被拒绝：docs/ 或 projects/ 的结构变了，但 README.md 没有同步" >&2
  echo "" >&2
  echo "   README.md 是本仓库对外（尤其是对 AI agent）的目录索引，" >&2
  echo "   结构一变就必须同步，否则索引会悄悄失真。" >&2
  echo "" >&2
  echo "   触发本条的结构变化（A=新增 D=删除 R=改名 C=复制）：" >&2
  printf '%s\n' "$structural" | awk -F'\t' '{print "     · [" $1 "] " $2}' >&2
  echo "" >&2
  echo "   补救（三步）：" >&2
  echo "     1) 打开 README.md，把上面这些条目在索引表里加/删/改名" >&2
  echo "     2) git add README.md" >&2
  echo "     3) git commit  （重新执行你刚才那条提交命令）" >&2
  echo "" >&2
  echo "   说明：只有新增/删除/改名会触发本条；改内容不触发，避免噪音。" >&2
  echo "" >&2
fi

exit "$fail"
